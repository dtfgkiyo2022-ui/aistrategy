:root {
    --hud-panel: #efe3c8;
    --hud-panel-border: #4a3a26;
    --hud-panel-inner-border: rgba(156, 135, 98, 0.55);
    --hud-resource-panel: #f8efd9;
    --hud-resource-border: #9c8762;
    --hud-divider: #9c8762;
    --hud-input: #f8efd9;
    --hud-button: #a2381f;
    --hud-button-text: #fbf2de;
    --hud-staff-panel: #efe3c8;
    --hud-staff-chat: #f8efd9;
    --hud-staff-you-bg: #ead3ae;
    --hud-staff-you-text: #3a1f12;
    --hud-staff-bg: #f5e8ca;
    --hud-staff-text: #2e2418;
    --hud-staff-detail-bg: #e4d2b0;
    --hud-staff-detail-text: #7a6a52;
    --hud-staff-bad-bg: #edc1ad;
    --hud-staff-bad-text: #6e2418;
    --hud-staff-bubble-border: #9c8762;
    --hud-staff-menu: #f8efd9;
    --hud-staff-button: #a2381f;
    --hud-staff-button-hover: #be5737;
    --hud-staff-button-border: #4a3a26;
    --hud-staff-input: #f8efd9;
    --hud-staff-input-text: #2e2418;
    --hud-staff-input-border: #9c8762;
    --hud-staff-tag-radius: 1px;
    --hud-shadow: rgba(46, 36, 24, 0.35);
    --hud-text: #2e2418;
    --hud-muted-text: #7a6a52;
    --hud-heading: #3a1f12;
    --hud-accent: #a2381f;
    --hud-good: #4f7a35;
    --hud-warning: #a2381f;
    --hud-font-size: 15px;
    --hud-small-font-size: 11px;
    --hud-heading-size: 20px;
    --hud-age-stage-size: 10px;
    --hud-top-height: 68px;
    --hud-padding: 8px;
    --hud-gap: 7px;
    --hud-border-width: 2px;
    --hud-radius: 2px;
    --hud-inner-radius: 0px;
    --hud-icon-radius: 0px;
    --hud-icon-size: 18px;
    --hud-resource-width: 64px;
    --hud-resource-height: 36px;
    --hud-status-line-height: 17px;
    --hud-number-width: 48px;
    --hud-age-width: 176px;
    --hud-status-width: 134px;
    --hud-heading-letter-spacing: 0px;
}

.hud-panel-shadow {
    display: flex;
}
