/* Variables live on the document root this HUD tags (HudToolkit adds "hud-document"); a sheet attached to
   rootVisualElement never matches :root, which is the panel above it. */
.hud-document {
    --hud-panel: #241f19;
    --hud-panel-border: #8a6b36;
    --hud-panel-inner-border: #4a3f2e;
    --hud-resource-panel: #241f19;
    --hud-resource-border: #5a4828;
    --hud-divider: #4a3f2e;
    --hud-input: #14110d;
    --hud-button: #c99a43;
    --hud-button-text: #1d140a;
    --hud-staff-panel: #241f19;
    --hud-staff-chat: #14110d;
    --hud-staff-you-bg: #3a5363;
    --hud-staff-you-text: #f2f5f0;
    --hud-staff-bg: #332d24;
    --hud-staff-text: #efe6d2;
    --hud-staff-detail-bg: #28231d;
    --hud-staff-detail-text: #b3a688;
    --hud-staff-bad-bg: #522b25;
    --hud-staff-bad-text: #ffd0bd;
    --hud-staff-bubble-border: #5a4828;
    --hud-staff-menu: #2d261d;
    --hud-staff-button: #c99a43;
    --hud-staff-button-hover: #e9b24c;
    --hud-staff-button-border: #8a6b36;
    --hud-staff-input: #14110d;
    --hud-staff-input-text: #efe6d2;
    --hud-staff-input-border: #8a6b36;
    --hud-staff-tag-radius: 2px;
    --hud-shadow: rgba(20, 17, 13, 0.35);
    --hud-text: #efe6d2;
    --hud-muted-text: #b3a688;
    --hud-heading: #f3d48a;
    --hud-accent: #e9b24c;
    --hud-good: #9cc27a;
    --hud-warning: #e98a5a;
    --hud-font-size: 15px;
    --hud-small-font-size: 11px;
    --hud-heading-size: 20px;
    --hud-age-stage-size: 10px;
    --hud-top-height: 64px;
    --hud-padding: 7px;
    --hud-gap: 6px;
    --hud-border-width: 1px;
    --hud-radius: 3px;
    --hud-inner-radius: 1px;
    --hud-icon-radius: 2px;
    --hud-icon-size: 12px;
    --hud-resource-width: 64px;
    --hud-resource-height: 36px;
    --hud-status-line-height: 17px;
    --hud-number-width: 48px;
    --hud-age-width: 170px;
    --hud-status-width: 132px;
    --hud-heading-letter-spacing: 0px;
}
