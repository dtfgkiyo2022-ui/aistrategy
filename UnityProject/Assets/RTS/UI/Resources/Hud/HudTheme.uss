.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* The frame holds the place of the bar; the shadow plate comes first inside it so it is drawn behind the bar
   (USS has no z-index: later siblings draw on top). */
.hud-top-frame {
    position: absolute;
    left: 10px;
    right: 58%;
    top: 10px;
    height: var(--hud-top-height);
}

.hud-top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--hud-top-height);
    padding: var(--hud-padding);
    background-color: var(--hud-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    font-size: var(--hud-font-size);
    overflow: visible;
}

.hud-panel-shadow {
    position: absolute;
    left: 4px;
    top: 4px;
    right: -4px;
    bottom: -4px;
    display: none;
    background-color: var(--hud-shadow);
    border-radius: var(--hud-radius);
}

.hud-panel-inner-border {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    border-width: 1px;
    border-color: var(--hud-panel-inner-border);
    border-radius: var(--hud-inner-radius);
}

.hud-top-line {
    flex-direction: row;
    height: 100%;
    align-items: center;
}

.hud-age-block {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    width: var(--hud-age-width);
    padding-left: var(--hud-gap);
    padding-right: var(--hud-gap);
}

/* Civilisation and age names run up to about fifteen characters, so the name wraps to two lines at a
   slightly smaller size instead of being cut off (10-08). */
.hud-age {
    margin: 0;
    padding: 0;
    color: var(--hud-heading);
    font-size: 16px;
    overflow: hidden;
    white-space: normal;
    -unity-text-align: middle-left;
}

.hud-age-stage {
    color: var(--hud-muted-text);
    font-size: var(--hud-age-stage-size);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.hud-resource-row {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    align-items: center;
}

.hud-resource {
    flex-direction: row;
    flex-shrink: 0;
    min-width: var(--hud-resource-width);
    height: var(--hud-resource-height);
    margin-right: var(--hud-gap);
    padding-left: var(--hud-gap);
    padding-right: var(--hud-gap);
    background-color: var(--hud-resource-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-resource-border);
    border-radius: var(--hud-radius);
    align-items: center;
}

.hud-resource-icon,
.hud-population-icon {
    width: var(--hud-icon-size);
    height: var(--hud-icon-size);
    margin-right: var(--hud-gap);
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--hud-accent);
    -unity-background-scale-mode: scale-to-fit;
    border-radius: var(--hud-icon-radius);
}

.hud-resource-text {
    flex-direction: column;
    justify-content: center;
}

.hud-resource-name {
    margin: 0;
    padding: 0;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
}

.hud-resource-value {
    margin: 0;
    padding: 0;
    color: var(--hud-text);
    font-size: var(--hud-font-size);
    width: var(--hud-number-width);
    white-space: nowrap;
    -unity-text-align: middle-right;
}

.hud-status-block {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
    width: var(--hud-status-width);
    padding-left: var(--hud-gap);
    padding-right: var(--hud-gap);
}

.hud-status-line {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: var(--hud-status-line-height);
}

.hud-population-line .hud-population-icon {
    flex-shrink: 0;
}

.hud-population {
    flex-grow: 1;
    color: var(--hud-text);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.hud-idle {
    height: var(--hud-status-line-height);
    color: var(--hud-text);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.hud-idle.is-warning {
    color: var(--hud-warning);
}

.hud-heading {
    letter-spacing: var(--hud-heading-letter-spacing);
}

.hud-staff-frame {
    position: absolute;
}

.hud-staff-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--hud-padding);
    background-color: var(--hud-staff-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    overflow: hidden;
    flex-direction: column;
}

.staff-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
}

.staff-title {
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    flex-grow: 1;
}

.staff-ai-button,
.staff-send-button,
.staff-cancel-button,
.staff-ai-option {
    color: var(--hud-button-text);
    background-color: var(--hud-staff-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-staff-button-border);
    border-radius: var(--hud-radius);
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
}

.staff-ai-button {
    min-width: 142px;
    max-width: 190px;
}

.staff-ai-button:hover,
.staff-send-button:hover,
.staff-cancel-button:hover,
.staff-ai-option:hover {
    background-color: var(--hud-staff-button-hover);
}

.staff-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 6px;
    margin-bottom: 5px;
    background-color: var(--hud-staff-chat);
    border-width: 1px;
    border-color: var(--hud-divider);
    border-radius: var(--hud-inner-radius);
}

.staff-line {
    flex-direction: row;
    width: 100%;
    margin-bottom: 4px;
}

.staff-line-you {
    justify-content: flex-end;
}

.staff-line-staff,
.staff-line-detail,
.staff-line-bad {
    justify-content: flex-start;
}

.staff-bubble {
    max-width: 88%;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: var(--hud-radius);
    border-width: 1px;
    border-color: var(--hud-staff-bubble-border);
}

.staff-tone-you {
    background-color: var(--hud-staff-you-bg);
    color: var(--hud-staff-you-text);
}

.staff-tone-staff {
    background-color: var(--hud-staff-bg);
    color: var(--hud-staff-text);
}

.staff-tone-detail {
    background-color: var(--hud-staff-detail-bg);
    color: var(--hud-staff-detail-text);
}

.staff-tone-bad {
    background-color: var(--hud-staff-bad-bg);
    color: var(--hud-staff-bad-text);
}

.staff-line-text {
    font-size: var(--hud-small-font-size);
    white-space: normal;
    -unity-text-align: middle-left;
}

.staff-line-status .staff-bubble {
    border-radius: var(--hud-staff-tag-radius);
    padding-top: 2px;
    padding-bottom: 2px;
}

.staff-empty-label {
    position: absolute;
    left: var(--hud-padding);
    right: var(--hud-padding);
    top: 45px;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.staff-footer {
    flex-shrink: 0;
}

.staff-meta-row,
.staff-action-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.staff-target-label {
    flex-grow: 1;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    overflow: hidden;
}

.staff-estimate-label {
    display: none;
    color: var(--hud-warning);
    font-size: var(--hud-small-font-size);
    margin-left: 6px;
    white-space: nowrap;
}

.staff-estimate-label.is-visible,
.staff-notice-label.is-visible {
    display: flex;
}

.staff-input {
    flex-grow: 0;
    height: 32px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: var(--hud-staff-input);
    color: var(--hud-staff-input-text);
    border-width: 1px;
    border-color: var(--hud-staff-input-border);
    border-radius: var(--hud-inner-radius);
}

.staff-input .unity-base-text-field__input {
    background-color: var(--hud-staff-input);
    color: var(--hud-staff-input-text);
}

.staff-send-button {
    min-width: 62px;
}

.staff-cancel-button {
    margin-left: 5px;
    min-width: 112px;
}

.staff-cost-label {
    flex-grow: 1;
    margin-left: 7px;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    -unity-text-align: middle-right;
}

.staff-notice-label {
    display: none;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.staff-notice-label.is-warning {
    color: var(--hud-warning);
}

.staff-ai-options {
    position: absolute;
    right: var(--hud-padding);
    top: 38px;
    width: 190px;
    padding: 4px;
    display: none;
    flex-direction: column;
    background-color: var(--hud-staff-menu);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
}

.staff-ai-option {
    margin-bottom: 3px;
    white-space: normal;
}

.hud-commands-frame {
    position: absolute;
}

.hud-commands-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--hud-padding);
    background-color: var(--hud-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    overflow: hidden;
    flex-direction: column;
}

.commands-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 24px;
}

.commands-title {
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    flex-shrink: 0;
}

.commands-help {
    flex-grow: 1;
    margin-left: var(--hud-gap);
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-right;
}

.commands-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    margin-top: 4px;
}

.commands-selection {
    flex-shrink: 0;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hud-divider);
    flex-direction: column;
}

.commands-selection-title {
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    white-space: normal;
}

.commands-selection-detail,
.commands-selection-hint {
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.commands-selection-hint {
    margin-top: 6px;
}

.commands-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.command-cell {
    flex-direction: row;
    width: 50%;
    min-height: 36px;
    padding-right: 2px;
    padding-bottom: 4px;
}

.command-button {
    flex-grow: 1;
    min-height: 29px;
    padding-left: 2px;
    padding-right: 2px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    font-size: var(--hud-font-size);
    white-space: normal;
    -unity-text-align: middle-center;
}

.command-button:hover {
    background-color: var(--hud-accent);
}

.command-button:disabled {
    color: var(--hud-muted-text);
    background-color: var(--hud-resource-panel);
    border-color: var(--hud-divider);
}

.command-key-hint {
    width: 0;
    flex-shrink: 0;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    -unity-text-align: middle-center;
}

.hud-economy-frame {
    position: absolute;
}

.hud-economy-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--hud-padding);
    background-color: var(--hud-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    overflow: hidden;
    flex-direction: column;
}

.economy-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 24px;
}

.economy-title,
.economy-header-status,
.economy-hint,
.economy-notice,
.economy-reason,
.economy-message {
    margin: 0;
    padding: 0;
}

.economy-title {
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    flex-shrink: 0;
}

.economy-header-status {
    flex-grow: 1;
    margin-left: var(--hud-gap);
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-right;
}

.economy-tabs {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 28px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.economy-tab {
    flex-grow: 1;
    height: 26px;
    margin: 0 4px 0 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 2px;
    padding-right: 2px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    font-size: var(--hud-small-font-size);
}

.economy-tab:hover,
.economy-tab.is-selected {
    background-color: var(--hud-accent);
}

.economy-actions {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: var(--hud-resource-panel);
    border-width: 1px;
    border-color: var(--hud-divider);
    border-radius: var(--hud-inner-radius);
    padding: 4px;
}

/* Four buttons to a row: the scroll view's content wraps, and a disabled button's reason sits under it. */
.economy-actions .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.economy-action-row {
    flex-direction: column;
    width: 25%;
    padding-right: 4px;
    margin-bottom: 4px;
}

.economy-action-row.is-message-row {
    width: 100%;
}

.economy-action {
    min-width: 0;
    height: 26px;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    font-size: var(--hud-small-font-size);
    white-space: normal;
    -unity-text-align: middle-center;
}

.economy-action:hover {
    background-color: var(--hud-accent);
}

.economy-action:disabled {
    color: var(--hud-muted-text);
    background-color: var(--hud-resource-panel);
    border-color: var(--hud-divider);
}

.economy-action.is-selected {
    background-color: var(--hud-accent);
}

.economy-action.is-message {
    flex-grow: 1;
    color: var(--hud-muted-text);
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
}

.economy-reason {
    margin-top: 1px;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
    -unity-text-align: middle-left;
}

.economy-hint,
.economy-notice {
    flex-shrink: 0;
    min-height: 19px;
    margin-top: 3px;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.economy-notice {
    color: var(--hud-heading);
}

.hud-supply-frame,
.hud-timeline-frame,
.hud-clock-frame {
    position: absolute;
}

.hud-supply-panel,
.hud-timeline-panel,
.hud-clock-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--hud-padding);
    background-color: var(--hud-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    overflow: hidden;
}

.hud-supply-panel,
.hud-timeline-panel,
.hud-clock-panel {
    flex-direction: column;
}

.hud-supply-panel Label,
.hud-timeline-panel Label,
.hud-clock-panel Label {
    margin: 0;
    padding: 0;
}

.supply-title,
.timeline-title {
    flex-shrink: 0;
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    min-height: 22px;
}

.supply-units {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--hud-text);
    font-size: var(--hud-font-size);
    white-space: nowrap;
}

.supply-line {
    flex-shrink: 0;
    min-height: 20px;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    overflow: hidden;
}

.timeline-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 4px;
    padding: 3px;
    background-color: var(--hud-resource-panel);
    border-width: 1px;
    border-color: var(--hud-divider);
    border-radius: var(--hud-inner-radius);
}

.timeline-scroll .unity-scroll-view__content-container {
    flex-direction: column;
}

.timeline-line-text {
    flex-shrink: 0;
    min-height: 18px;
    margin: 0 0 2px 0;
    padding: 0;
    color: var(--hud-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.clock-info {
    flex-shrink: 0;
    min-height: 17px;
    color: var(--hud-heading);
    font-size: var(--hud-small-font-size);
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.clock-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 22px;
    margin-top: 1px;
}

.clock-button,
.clock-faction {
    flex-shrink: 0;
    height: 21px;
    margin: 0 2px 0 0;
    padding: 0 5px 0 5px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    font-size: var(--hud-small-font-size);
    -unity-text-align: middle-center;
}

.clock-button {
    min-width: 32px;
}

.clock-faction {
    min-width: 48px;
}

.clock-button:hover,
.clock-faction:hover,
.clock-button.is-selected {
    background-color: var(--hud-accent);
}

.clock-button:disabled,
.clock-faction:disabled {
    color: var(--hud-muted-text);
    background-color: var(--hud-resource-panel);
    border-color: var(--hud-divider);
}

/* Match setup, language, command log and result overlays. The content is deliberately ordinary flex layout: UI
   Toolkit USS has no grid or gap support in the Unity versions used by the HUD. */
.hud-setup-controls-frame {
    position: absolute;
    flex-direction: row;
    height: 28px;
}

.hud-top-control,
.hud-log-toggle-button,
.setup-button,
.result-restart {
    margin: 0;
    padding: 0 6px 0 6px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    font-size: var(--hud-small-font-size);
    -unity-text-align: middle-center;
}

.hud-top-control {
    width: 64%;
    height: 28px;
}

.hud-language-toggle {
    width: 36%;
}

.hud-top-control:hover,
.hud-log-toggle-button:hover,
.setup-button:hover,
.setup-button.is-selected,
.result-restart:hover {
    background-color: var(--hud-accent);
}

.hud-setup-frame,
.hud-log-status-frame,
.hud-log-entries-frame,
.hud-result-frame {
    position: absolute;
}

.hud-setup-panel,
.hud-log-panel,
.hud-result-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--hud-padding);
    background-color: var(--hud-panel);
    border-width: var(--hud-border-width);
    border-color: var(--hud-panel-border);
    border-radius: var(--hud-radius);
    color: var(--hud-text);
    overflow: hidden;
    flex-direction: column;
}

.hud-setup-panel Label,
.hud-setup-panel Button,
.hud-setup-panel Toggle,
.hud-log-panel Label,
.hud-log-panel Button,
.hud-result-panel Label,
.hud-result-panel Button {
    margin: 0;
    padding: 0;
}

.setup-title,
.log-section-title {
    flex-shrink: 0;
    min-height: 23px;
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
}

.setup-scroll,
.log-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 3px 0 0 0;
    padding: 3px;
    background-color: var(--hud-resource-panel);
    border-width: 1px;
    border-color: var(--hud-divider);
    border-radius: var(--hud-inner-radius);
}

.setup-scroll .unity-scroll-view__content-container,
.log-scroll .unity-scroll-view__content-container {
    flex-direction: column;
}

.setup-content {
    flex-direction: column;
    width: 100%;
}

.setup-row {
    flex-direction: row;
    flex-shrink: 0;
    width: 100%;
    min-height: 29px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hud-divider);
}

.setup-label {
    width: 106px;
    flex-shrink: 0;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
    -unity-text-align: middle-left;
}

.setup-control {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.setup-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 72px;
    min-height: 25px;
    color: var(--hud-button-text);
    background-color: var(--hud-button);
    white-space: normal;
}

.setup-choice-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    flex-shrink: 0;
}

.setup-choice-grid .setup-button {
    width: 50%;
    flex-grow: 0;
}

.setup-switch {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 25px;
    color: var(--hud-text);
    font-size: var(--hud-small-font-size);
}

.setup-inline-row,
.setup-nudge-row {
    flex-direction: row;
    width: 100%;
    flex-shrink: 0;
}

.setup-nudge-row {
    width: 140px;
}

.setup-nudge-row .setup-button {
    min-width: 44px;
}

.setup-subtitle,
.setup-param-label,
.setup-hint,
.setup-status,
.setup-console,
.setup-credits,
.log-line,
.result-detail,
.result-pack {
    margin: 0;
    padding: 0;
    color: var(--hud-muted-text);
    font-size: var(--hud-small-font-size);
    white-space: normal;
}

.setup-subtitle,
.setup-param-label {
    width: 100%;
    color: var(--hud-heading);
}

.setup-hint {
    width: 100%;
    color: var(--hud-muted-text);
}

.setup-status {
    width: 100%;
    color: var(--hud-muted-text);
}

.setup-console {
    width: 100%;
    white-space: normal;
}

.setup-slider {
    flex-grow: 1;
    min-width: 180px;
    height: 24px;
    margin: 0;
}

.setup-credits {
    flex-shrink: 0;
    min-height: 22px;
    color: var(--hud-muted-text);
}

.hud-log-toggle-frame {
    position: absolute;
}

.hud-log-toggle-button {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.log-line {
    flex-shrink: 0;
    min-height: 19px;
    padding: 0 2px 2px 2px;
    color: var(--hud-text);
}

.result-headline {
    flex-shrink: 0;
    min-height: 48px;
    color: var(--hud-heading);
    font-size: var(--hud-heading-size);
    white-space: normal;
}

.result-detail {
    min-height: 40px;
    color: var(--hud-text);
}

.result-pack {
    min-height: 32px;
}

.result-restart {
    align-self: center;
    min-width: 160px;
    min-height: 32px;
    margin-top: 4px;
}
