<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- #448: .NET 10 dynamic PGO crashed the runtime (Internal CLR error in ContractList.Copy) on this Zen 4 PC,
         about 18 of 40 large-map runs; with PGO off 0 of 40. Headless only (the player build is IL2CPP). -->
    <TieredPGO>false</TieredPGO>
    <!-- #448: PGO off was not enough (1 of 3 runs still crashed); on-stack replacement of long tier-0 loops is the
         remaining suspect. Loops start fully optimised instead (0 of 3 with this setting, also 0 with OSR off). -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rts.Core/Rts.Core.csproj" />
    <!-- The JavaScript tactic runtime (Jint) runs outside the simulation, like the providers, so it is linked here, not in Rts.Core. -->
    <Compile Include="../../UnityProject/Assets/RTS/TacticsJs/**/*.cs" Link="TacticsJs/%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="Jint" HintPath="../../UnityProject/Assets/RTS/TacticsJs/Plugins/Jint.dll" />
    <Reference Include="Acornima" HintPath="../../UnityProject/Assets/RTS/TacticsJs/Plugins/Acornima.dll" />
    <Reference Include="System.Runtime.CompilerServices.Unsafe" HintPath="../../UnityProject/Assets/RTS/TacticsJs/Plugins/System.Runtime.CompilerServices.Unsafe.dll" />
    <!-- The external-model provider. It is not part of the deterministic core, so it is linked here, not in Rts.Core. -->
    <Compile Include="../../UnityProject/Assets/RTS/Providers/**/*.cs" Link="Providers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Hash the sources shipped with this binary, even if the checkout is subsequently edited. -->
  <ItemGroup>
    <EmbeddedResource Include="../../UnityProject/Assets/RTS/Contracts/**/*.cs" LogicalName="Source/UnityProject/Assets/RTS/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../UnityProject/Assets/RTS/Decision/**/*.cs" LogicalName="Source/UnityProject/Assets/RTS/Decision/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../UnityProject/Assets/RTS/Simulation/**/*.cs" LogicalName="Source/UnityProject/Assets/RTS/Simulation/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../UnityProject/Assets/RTS/Replay/**/*.cs" LogicalName="Source/UnityProject/Assets/RTS/Replay/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../UnityProject/Assets/RTS/Application/**/*.cs" LogicalName="Source/UnityProject/Assets/RTS/Application/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
