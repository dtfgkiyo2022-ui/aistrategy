<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" PrivateAssets="all" />
    <ProjectReference Include="../Rts.Core/Rts.Core.csproj" />
  </ItemGroup>
  <!-- Allowlist: add only tests that do not depend on UnityEngine or UnityEditor. -->
  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/MovementTests.cs" Link="Tests/MovementTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/ReinforcementTests.cs" Link="Tests/ReinforcementTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/DeterminismSourceTests.cs" Link="Tests/DeterminismSourceTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/CommandStateTests.cs" Link="Tests/CommandStateTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/CommandTestInput.cs" Link="Tests/CommandTestInput.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/PolicyDecisionTests.cs" Link="Tests/PolicyDecisionTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/AutoOffenseDecisionTests.cs" Link="Tests/AutoOffenseDecisionTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/ContractsTests.cs" Link="Tests/ContractsTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/Fix64Tests.cs" Link="Tests/Fix64Tests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/SplitMix64Tests.cs" Link="Tests/SplitMix64Tests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/ReplayTests.cs" Link="Tests/ReplayTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/MapOutpostTests.cs" Link="Tests/MapOutpostTests.cs" />
    <Compile Include="../../UnityProject/Assets/RTS/Tests/EditMode/SimulationTests.cs" Link="Tests/SimulationTests.cs" />
  </ItemGroup>
</Project>
